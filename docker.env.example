# Copy this file to docker.env for local development. Never commit docker.env.
PUID=1000
PGID=1000
TZ=America/New_York

# Local-only database credentials. Use unique values for your workstation.
MYSQL_ROOT_HOST=%
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_USER=acedockeruser
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_DATABASE=ace%

ACE_WORLD_NAME=ACEmulator
ACE_DAT_FILES_DIRECTORY=/ace/Dats
ACE_SQL_AUTH_DATABASE_NAME=ace_auth
ACE_SQL_AUTH_DATABASE_HOST=ace-db
ACE_SQL_AUTH_DATABASE_PORT=3306
ACE_SQL_SHARD_DATABASE_NAME=ace_shard
ACE_SQL_SHARD_DATABASE_HOST=ace-db
ACE_SQL_SHARD_DATABASE_PORT=3306
ACE_SQL_WORLD_DATABASE_NAME=ace_world
ACE_SQL_WORLD_DATABASE_HOST=ace-db
ACE_SQL_WORLD_DATABASE_PORT=3306
ACE_SQL_INITIALIZE_DATABASES=true
ACE_SQL_DOWNLOAD_LATEST_WORLD_RELEASE=true
ACE_SQL_NONINTERACTIVE_SETUP=true

# The Market API's service key (local market stack, scripts/market). Every API request but /health must carry it; the BFF (market-web)
# adds it to every request it sends the API. At least 32 characters (ServiceGate.MinimumKeyLength). Generate one with: openssl rand -hex 32
MARKET_SERVICE_KEY=

# The secret the BFF (market-web) signs its session cookie with. At least 32 characters. Changing it signs everyone out.
# Generate one with: openssl rand -hex 32
MARKET_COOKIE_SECRET=

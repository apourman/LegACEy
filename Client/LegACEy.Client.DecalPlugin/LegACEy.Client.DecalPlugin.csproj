<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DecalInstallDir Condition="'$(DecalInstallDir)' == ''">C:\Program Files (x86)\Decal 3.0</DecalInstallDir>
    <VirindiViewServiceDir Condition="'$(VirindiViewServiceDir)' == ''">C:\Games\VirindiPlugins\VirindiViewService</VirindiViewServiceDir>
    <ManagedDirectXDir Condition="'$(ManagedDirectXDir)' == ''">C:\Windows\Microsoft.NET\DirectX for Managed Code\1.0.2902.0</ManagedDirectXDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Decal.Adapter">
      <HintPath>$(DecalInstallDir)\Decal.Adapter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VirindiViewService">
      <HintPath>$(VirindiViewServiceDir)\VirindiViewService.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.DirectX">
      <HintPath>$(ManagedDirectXDir)\Microsoft.DirectX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.DirectX.Direct3D">
      <HintPath>$(ManagedDirectXDir)\Microsoft.DirectX.Direct3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\LegACEy.Client.PanelHost\LegACEy.Client.PanelHost.csproj" />
  </ItemGroup>

  <Target Name="VerifyAvaloniaX86NativeAssets" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(TargetDir)x86\libSkiaSharp.dll')" Text="The x86 SkiaSharp native library must ship in the plugin output." />
    <Error Condition="!Exists('$(TargetDir)x86\libHarfBuzzSharp.dll')" Text="The x86 HarfBuzz native library must ship in the plugin output." />
  </Target>
</Project>

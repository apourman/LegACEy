{
  "name": "legacey-market-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "react-router build",
    "test:browser": "playwright test",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "generate:api": "openapi-typescript ../Source/ACE.MarketApi/openapi.json -o src/api-schema.ts",
    "start": "NODE_ENV=production node server.js",
    "test:bff": "vitest run"
  },
  "dependencies": {
    "@mjackson/node-fetch-server": "0.2.0",
    "@react-router/node": "7.18.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.55.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}

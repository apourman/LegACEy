<Project Sdk="Microsoft.NET.Sdk">
  <!-- Applies a staged release after the game exits. net48 because every supported Windows has it; WinExe so no console opens. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Build under this project's own bin folder even when the stub is built with the output option. The stub copies the exe
         into its output root. -->
    <OutDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/</OutDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Chorizite.DatReaderWriter" Version="2.1.7" />
  </ItemGroup>
  <!-- The exe is copied on its own (into the stage it applies), so every referenced DLL is embedded in it and loaded from there
       (Program.EmbeddedAssembly). -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool: builds a world patch and its manifest from an edited dat folder and a retail one. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Chorizite.DatReaderWriter" Version="2.1.7" />
  </ItemGroup>
  <ItemGroup>
    <!-- The patch format, and for the check the updater's own apply. -->
    <Compile Include="..\LegACEy.Updater\WorldFiles.cs" LinkBase="Updater" />
    <Compile Include="..\LegACEy.Updater\WorldApply.cs" LinkBase="Updater" />
    <Compile Include="..\LegACEy.Updater\StageApply.cs" LinkBase="Updater" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The LegACEy client on .NET 10, started inside acclient by the Decal plugin. The IL stays AnyCPU so the tests load it on
       x64; the game build selects x86 with -r win-x86. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every restore includes the game's runtime, whoever runs it (an IDE's background restore, the stub's build), so the win-x86
         publish never finds an assets file without it (NETSDK1047). -->
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The release publishes the client self-contained for win-x86, trimmed, into runtime\ beside the stub (see the README).
       Plugins load from Plugins\ at run time, outside the trim graph, so what they reach must survive. Partial mode trims only
       assemblies marked trimmable (the framework, Avalonia, Skia, Reloaded); the roots keep Avalonia, Skia, the hook library and
       the everyday framework surface whole. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Trimming turns EventSource off by default; GcStarts reads the runtime's GC events for the performance log. -->
    <EventSourceSupport>true</EventSourceSupport>
    <!-- Trim warnings show on publish only; plain builds and tests stay quiet. -->
    <EnableTrimAnalyzer Condition="'$(_IsPublishing)' != 'true'">false</EnableTrimAnalyzer>
    <!-- Precompiled x86 code: without it the first in-world frame spent about 1 s in the JIT (in game, 11 Oct). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not precompiled: these subclass Avalonia controls, and crossgen's x86 layout of their fields did not match the runtime's (a
         toolbar medallion read its Clicked handler from the wrong offset and crashed the game on click, 14 Oct). They JIT instead. -->
    <PublishReadyToRunExclude Include="LegACEy.Client.Themes.dll;LegACEy.Client.Demo.dll" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia;Avalonia.Base;Avalonia.Controls;Avalonia.Dialogs;Avalonia.Markup;Avalonia.Markup.Xaml;Avalonia.Skia;Avalonia.Themes.Simple;Avalonia.Headless;SkiaSharp;HarfBuzzSharp;Reloaded.Hooks;Reloaded.Hooks.Definitions;Reloaded.Memory;Reloaded.Memory.Buffers;Reloaded.Assembler" />
    <!-- The plugin API surface. netstandard is a pure facade; its root keeps the type forwards plugins bind through (trimming
         strips forwards nothing in the graph uses). The rest keeps the everyday framework code whole. Checked once on 10 Oct with
         a System.Reflection.Metadata scan following netstandard's forwards: every type and member the three plugins and the
         LegACEy libraries reference resolves in the trimmed runtime\.
         ponytail: Xml, Net and Crypto stay trimmed; root more if a plugin logs MissingMethodException. -->
    <TrimmerRootAssembly Include="netstandard;System.Private.CoreLib;System.Collections;System.Collections.Concurrent;System.Collections.NonGeneric;System.Collections.Specialized;System.Linq;System.ObjectModel;System.ComponentModel;System.ComponentModel.Primitives;System.ComponentModel.TypeConverter;System.Drawing.Primitives;System.Text.RegularExpressions;System.Memory;System.Runtime.InteropServices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LegACEy.Client.Tests" />
    <!-- The water's shaders, compiled in game by Windows' d3dcompiler_47. -->
    <EmbeddedResource Include="Water.hlsl" LogicalName="Water.hlsl" />
    <EmbeddedResource Include="Weather.hlsl" LogicalName="Weather.hlsl" />
    <PackageReference Include="Reloaded.Hooks" Version="4.3.3" />
    <ProjectReference Include="..\LegACEy.Client.PanelHost\LegACEy.Client.PanelHost.csproj" />
    <ProjectReference Include="..\LegACEy.Client.InputRouter\LegACEy.Client.InputRouter.csproj" />
    <ProjectReference Include="..\LegACEy.Client.GameArt\LegACEy.Client.GameArt.csproj" />
    <ProjectReference Include="..\LegACEy.Client.Demo\LegACEy.Client.Demo.csproj" />
    <ProjectReference Include="..\LegACEy.Client.Themes\LegACEy.Client.Themes.csproj" />
  </ItemGroup>
</Project>

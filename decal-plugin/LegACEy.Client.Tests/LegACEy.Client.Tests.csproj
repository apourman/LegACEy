<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Chorizite.DatReaderWriter" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegACEy.Client\LegACEy.Client.csproj" />
    <ProjectReference Include="..\LegACEy.Client.PanelHost\LegACEy.Client.PanelHost.csproj" />
    <ProjectReference Include="..\LegACEy.Client.InputRouter\LegACEy.Client.InputRouter.csproj" />
    <ProjectReference Include="..\LegACEy.Client.Demo\LegACEy.Client.Demo.csproj" />
    <ProjectReference Include="..\LegACEy.Plugin.Vault\LegACEy.Plugin.Vault.csproj" />
    <ProjectReference Include="..\LegACEy.Plugin.Market\LegACEy.Plugin.Market.csproj" />
    <ProjectReference Include="..\LegACEy.Plugin.Inventory\LegACEy.Plugin.Inventory.csproj" />
    <ProjectReference Include="..\LegACEy.Client.Themes\LegACEy.Client.Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The updater is net48, so its apply steps are compiled in here to be tested. WorldFiles.cs comes with the client. -->
    <Compile Include="..\LegACEy.Updater\StageApply.cs" LinkBase="Updater" />
    <Compile Include="..\LegACEy.Updater\WorldApply.cs" LinkBase="Updater" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The thin net48 stub Decal registers. It holds every Decal reference and starts the .NET 10 client from runtime\ beside it. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DecalInstallDir Condition="'$(DecalInstallDir)' == ''">C:\Program Files (x86)\Decal 3.0</DecalInstallDir>
    <DecalInteropDir Condition="'$(DecalInteropDir)' == ''">C:\Windows\Microsoft.NET\assembly\GAC_MSIL\Decal.Interop.Core\v4.0_2.9.8.3__481f17d392f1fb65</DecalInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Decal.Adapter">
      <HintPath>$(DecalInstallDir)\Decal.Adapter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Decal.Interop.Core">
      <HintPath>$(DecalInteropDir)\Decal.Interop.Core.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <!-- The item-type plate for the inventory rows. -->
    <ProjectReference Include="..\LegACEy.Client.GameArt\LegACEy.Client.GameArt.csproj" />
    <!-- The bridge tables: compiled here so the client's layout is the stub's, with no copy to drift. -->
    <Compile Include="..\LegACEy.Client\BridgeTables.cs" LinkBase="Client" />
  </ItemGroup>

  <!-- Plugins are built with the stub but not referenced by it. Each plugin's DLL is copied to Plugins\<Name>\ beside the stub,
       where the client loads them from. -->
  <ItemGroup>
    <ProjectReference Include="..\LegACEy.Plugin.Vault\LegACEy.Plugin.Vault.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LegACEy.Plugin.Inventory\LegACEy.Plugin.Inventory.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLegACEyPlugins" AfterTargets="Build">
    <MSBuild Projects="..\LegACEy.Plugin.Vault\LegACEy.Plugin.Vault.csproj;..\LegACEy.Plugin.Inventory\LegACEy.Plugin.Inventory.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="LegACEyPluginAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(LegACEyPluginAssembly);@(LegACEyPluginAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" DestinationFolder="$(OutDir)Plugins\%(Filename)" />
  </Target>
</Project>
